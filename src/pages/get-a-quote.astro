---
import { getEmDashEntry } from "emdash";
import ContactDetails from "../components/ContactDetails.astro";
import PageBody from "../components/PageBody.astro";
import PageHero from "../components/PageHero.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Base from "../layouts/Base.astro";
import { BUSINESS, entrySeo } from "../lib/site";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "get-a-quote");
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = entrySeo(Astro, page, "/get-a-quote", page.data.intro);

// Structured email request flow (Phase 4)
const quoteBody = [
	"Name: ",
	"Phone: ",
	"Company Name (optional): ",
	"Part details: ",
	"Metal / Substrate: ",
	"Dimensions & Weight of largest piece: ",
	"Quantity: ",
	"Desired finish / RAL colour code: ",
	"Timeline / Turnaround requirement: ",
	"",
	"Additional Notes / Photos attached:",
].join("\n");

const quoteMail = `mailto:${BUSINESS.email}?subject=${encodeURIComponent("Quote Request — Powder Coating Project")}&body=${encodeURIComponent(quoteBody)}`;

// Structured consultation request flow (Phase 5 fallback)
const consultBody = [
	"Name: ",
	"Phone: ",
	"Company Name: ",
	"Preferred consultation date / time: ",
	"Project overview: ",
	"Questions for our coating specialists: ",
].join("\n");

const consultMail = `mailto:${BUSINESS.email}?subject=${encodeURIComponent("Book a Consultation — Powder Coating Project")}&body=${encodeURIComponent(consultBody)}`;
---

<Base
	title={seo.title}
	pageTitle={page.data.title}
	description={seo.description}
	image={seo.image}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	<PageHero title={page.data.title} intro={page.data.intro} titleAttrs={page.edit.title}>
		<div class="quote-actions">
			<a href="#quote-form-section" class="btn btn-primary btn-lg">Online Quote Form</a>
			<a href={quoteMail} class="btn btn-secondary btn-lg">Email Your Quote Request</a>
			<a href={consultMail} class="btn btn-secondary btn-lg">Book a Consultation</a>
		</div>
	</PageHero>
	<PageBody page={page}>
		<QuoteForm />
		<section class="quote-contact">
			<h2>Speak Directly with a Powder Coating Specialist</h2>
			<p>Have questions about pretreatment, masking, oven limits, or custom RAL colour formulations? Contact our shop team:</p>
			<ContactDetails />
		</section>
	</PageBody>
</Base>

<style>
	.quote-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
	}

	.quote-contact {
		max-width: var(--max-width);
		margin-top: var(--spacing-3xl);
	}

	.quote-contact h2 {
		font-size: var(--font-size-2xl);
		margin-bottom: var(--spacing-xs);
	}

	.quote-contact p {
		color: var(--color-muted);
		margin: var(--spacing-sm) 0 var(--spacing-xl);
	}
</style>
