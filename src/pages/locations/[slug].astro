---
import { getEmDashEntry } from "emdash";
import LandingPage from "../../components/LandingPage.astro";

const { slug } = Astro.params;
const { entry, cacheHint } = slug ? await getEmDashEntry("locations", slug) : { entry: null, cacheHint: null };
if (!entry) return Astro.rewrite("/404");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

<LandingPage collection="locations" entry={entry} />
