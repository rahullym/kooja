---
import { getEmDashEntry, getTaxonomyTermsWithCacheHint } from "emdash";
import CardGrid, { type Card } from "../../components/CardGrid.astro";
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import DocHero from "../../components/doc/DocHero.astro";
import DocSections from "../../components/doc/DocSections.astro";
import { docHeroImage } from "../../lib/doc-images";
import Base from "../../layouts/Base.astro";
import { breadcrumbLd, collectionLd, docParts, entrySeo, faqLd, getSorted, type Faq } from "../../lib/site";

const [{ entry: page, cacheHint: pageHint }, { entries, cacheHint }, termsResult] = await Promise.all([
	getEmDashEntry("pages", "projects"),
	getSorted("projects"),
	getTaxonomyTermsWithCacheHint("project_category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(pageHint);
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}

const cards: Card[] = entries.map((entry) => {
	const terms = entry.data.terms?.project_category ?? [];
	return {
		title: entry.data.title,
		url: `/projects/${entry.id}`,
		text: entry.data.summary,
		image: entry.data.featured_image,
		meta: terms.map((term) => term.label).join(" · ") || null,
		tags: terms.map((term) => term.slug),
	};
});

// Only offer filters that would show something.
const used = new Set(cards.flatMap((card) => card.tags ?? []));
const filters = termsResult.data.filter((term) => used.has(term.slug));

const title = page?.data.title ?? "Powder Coating Projects";
const seo = page ? entrySeo(Astro, page, "/projects", page.data.intro) : null;
const crumbs = [{ label: "Our Work", url: "/projects" }];

// Built from the client's content document: the gallery sits where the
// document's gallery marker is.
const doc = docParts(page?.data.body);
const heroImage = doc.fromDoc ? await docHeroImage(page?.data.body) : null;
const jsonLd = [
	collectionLd({
		name: title,
		description: seo?.description,
		url: `${Astro.url.origin}/projects`,
		items: cards.map((card) => ({ name: card.title, url: `${Astro.url.origin}${card.url}` })),
	}),
	breadcrumbLd(Astro.url.origin, crumbs),
	faqLd((page?.data.faqs ?? []) as Faq[]),
];
---

<Base
	title={seo?.title ?? title}
	pageTitle={title}
	description={seo?.description}
	image={seo?.image}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	jsonLd={jsonLd}
>
	{page && doc.fromDoc ? (
		<>
			<DocHero title={title} intro={page.data.intro} byline={doc.byline} crumbs={crumbs} image={heroImage} titleAttrs={page.edit.title} />
			<DocSections value={page.data.body} heroImage={heroImage}>
				<div slot="gallery" class="doc-gallery-band">
			<div class="container projects">
				{filters.length > 1 && (
					<div class="filters" role="group" aria-label="Filter projects by type">
						<button type="button" class="filter" data-filter="" aria-pressed="true">All</button>
						{filters.map((term) => (
							<button type="button" class="filter" data-filter={term.slug} aria-pressed="false">{term.label}</button>
						))}
					</div>
				)}
				<CardGrid cards={cards} level={2} />
			</div>
				</div>
			</DocSections>
		</>
	) : (
		<>
	<PageHero title={title} intro={page?.data.intro} crumbs={crumbs} titleAttrs={page?.edit.title} byline={doc.byline} />
		<div class="container projects">
			{filters.length > 1 && (
				<div class="filters" role="group" aria-label="Filter projects by type">
					<button type="button" class="filter" data-filter="" aria-pressed="true">All</button>
					{filters.map((term) => (
						<button type="button" class="filter" data-filter={term.slug} aria-pressed="false">{term.label}</button>
					))}
				</div>
			)}
			<CardGrid cards={cards} level={2} />
		</div>
		</>
	)}

	{doc.fromDoc ? doc.cta && <CtaBand doc={doc.cta} /> : <CtaBand headline="Inspired by what you see?" text="Let us help bring your project to life." />}
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>(".filter");
	const cards = document.querySelectorAll<HTMLElement>(".projects .card");

	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			const filter = button.dataset.filter ?? "";
			buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
			cards.forEach((card) => {
				const tags = (card.dataset.tags ?? "").split(" ");
				card.hidden = filter !== "" && !tags.includes(filter);
			});
		});
	});
</script>

<style>
	.doc-gallery-band {
		padding: var(--spacing-2xl) 0 var(--spacing-3xl);
		border-top: 1px solid var(--color-border);
	}

	.projects {
		padding-top: var(--spacing-3xl);
		padding-bottom: var(--spacing-4xl);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-xl);
	}

	.filter {
		font: inherit;
		font-size: var(--font-size-sm);
		font-weight: 600;
		padding: var(--spacing-sm) var(--spacing-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
		color: var(--color-text);
		cursor: pointer;
	}

	.filter[aria-pressed="true"] {
		background: var(--color-brand);
		border-color: var(--color-brand);
		color: var(--color-on-brand);
	}
</style>
