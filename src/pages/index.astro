---
import { getEmDashEntry } from "emdash";
import DocHero from "../components/doc/DocHero.astro";
import DocSections from "../components/doc/DocSections.astro";
import CtaBand from "../components/CtaBand.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import Base from "../layouts/Base.astro";
import { docParts, entrySeo, faqLd, localBusinessLd, type Faq } from "../lib/site";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = page ? entrySeo(Astro, page, "/", page.data.intro) : null;

// When the home page has copy from the client's content document, show that
// copy in the document's order; otherwise fall back to the block layout.
const doc = docParts(page?.data.body);
// The hero photo from the original home page design (real shop photo).
const heroImage = ((page?.data.content ?? []) as { _type?: string; image?: unknown }[]).find((b) => b._type === "marketing_hero")?.image ?? null;
const jsonLd = doc.fromDoc ? [localBusinessLd(Astro.url.origin), faqLd((page?.data.faqs ?? []) as Faq[])] : localBusinessLd(Astro.url.origin);
---

<Base
	title={seo?.title}
	pageTitle={seo?.title}
	description={seo?.description}
	image={seo?.image}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	jsonLd={jsonLd}
>
	{
		page && doc.fromDoc ? (
			<>
				<DocHero feature title={page.data.title} intro={page.data.intro} byline={doc.byline} buttons={doc.heroButtons} image={heroImage} titleAttrs={page.edit.title} />
				<DocSections value={page.data.body} heroImage={heroImage} />
				{doc.cta && <CtaBand doc={doc.cta} />}
			</>
		) : page?.data.content ? (
			<div {...page.edit.content}>
				<MarketingBlocks value={page.data.content} />
			</div>
		) : (
			<div class="empty-state">
				<h1>Koojo Custom Powder Coating</h1>
				<p>Add sections to the Home page in the admin to get started.</p>
				{Astro.locals.user && (
					<a href="/_emdash/admin" class="btn btn-primary">
						Open Admin
					</a>
				)}
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.empty-state p {
		color: var(--color-muted);
		margin: var(--spacing-md) 0 var(--spacing-xl);
	}
</style>
