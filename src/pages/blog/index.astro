---
import { getEmDashEntry, getTaxonomyTermsWithCacheHint } from "emdash";
import CardGrid from "../../components/CardGrid.astro";
import CtaBand from "../../components/CtaBand.astro";
import FaqSection from "../../components/FaqSection.astro";
import PageHero from "../../components/PageHero.astro";
import Pagination from "../../components/Pagination.astro";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { getPosts, imageUrl, pageUrl, paginate, postCard, postCategory } from "../../lib/posts";
import { breadcrumbLd, collectionLd, entrySeo, faqLd, type Faq } from "../../lib/site";

const FEATURED_PER_CATEGORY = 3;

const [{ entry: page, cacheHint: pageHint }, { entries: posts, cacheHint }, termsResult] = await Promise.all([
	getEmDashEntry("pages", "blog"),
	getPosts(),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: false }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(pageHint);
	Astro.cache.set(cacheHint);
	Astro.cache.set(termsResult.cacheHint);
}

const clusters = termsResult.data
	.map((term) => {
		const inCategory = posts.filter((post) => postCategory(post)?.slug === term.slug);
		return { term, total: inCategory.length, posts: inCategory.slice(0, FEATURED_PER_CATEGORY) };
	})
	.filter((cluster) => cluster.total > 0);

// Every published guide, newest first, nine per page (?page=N).
const paged = paginate(posts, Astro.url.searchParams.get("page"));
if (!paged) return Astro.rewrite("/404");
const firstPage = paged.page === 1;

const title = page?.data.title ?? "Powder Coating Guides";
const faqs = (firstPage ? page?.data.faqs ?? [] : []) as Faq[];
const seo = page ? entrySeo(Astro, page, "/blog", page.data.intro) : null;
const pageSuffix = firstPage ? "" : ` (Page ${paged.page})`;
const description = seo?.description ?? "Powder coating guides from Koojo Custom Powder Coating in Milton, Ontario.";
const canonical = firstPage ? (seo?.canonical ?? `${Astro.url.origin}/blog`) : `${Astro.url.origin}${pageUrl("/blog", paged.page)}`;
const ogImage = seo?.image ?? imageUrl(Astro.url.origin, posts.find((post) => post.data.featured_image)?.data.featured_image, Astro.locals.emdash?.getPublicMediaUrl);
const crumbs = [{ label: "Blog", url: "/blog" }];
const jsonLd = [
	collectionLd({
		name: title,
		description: seo?.description,
		url: `${Astro.url.origin}/blog`,
		items: clusters.map(({ term }) => ({ name: term.label, url: `${Astro.url.origin}/blog/categories/${term.slug}` })),
	}),
	faqLd(faqs),
	breadcrumbLd(Astro.url.origin, crumbs),
];
---

<Base
	title={`${seo?.title ?? title}${pageSuffix}`}
	pageTitle={title}
	description={description}
	image={ogImage}
	canonical={canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	jsonLd={jsonLd}
>
	<PageHero title={title} intro={page?.data.intro} crumbs={crumbs} titleAttrs={page?.edit.title}>
		<nav class="topics" aria-label="Guide topics">
			{clusters.map(({ term }) => (
				<a href={`/blog/categories/${term.slug}`}>{term.label}</a>
			))}
		</nav>
	</PageHero>

	<div class="container blog">
		{firstPage && clusters.map(({ term, total, posts: featured }) => (
			<section class="cluster">
				<header>
					<h2>
						<a href={`/blog/categories/${term.slug}`}>{term.label}</a>
					</h2>
					{total > featured.length && (
						<a class="cluster-all" href={`/blog/categories/${term.slug}`}>
							All {total} guides<span class="sr-only"> in {term.label}</span>
						</a>
					)}
				</header>
				<CardGrid cards={featured.map(postCard)} />
			</section>
		))}
		<section class="all-guides" id="all-guides" aria-labelledby="all-guides-title">
			<header>
				<h2 id="all-guides-title">All guides{pageSuffix}</h2>
				<p class="label">{posts.length} articles</p>
			</header>
			<CardGrid cards={paged.items.map(postCard)} />
			<Pagination path="/blog" page={paged.page} totalPages={paged.totalPages} label="Blog pages" />
		</section>

		{firstPage && page?.data.body && (
			<div class="hub-body container" {...page.edit.body}>
				<Prose value={page.data.body} />
			</div>
		)}

		<FaqSection faqs={faqs} />
	</div>

	<CtaBand />
</Base>

<style>
	.topics {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-xl);
	}

	.topics a {
		font-size: var(--font-size-sm);
		font-weight: 600;
		padding: var(--spacing-sm) var(--spacing-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
	}

	.topics a:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
	}

	.blog {
		padding-top: var(--spacing-3xl);
		padding-bottom: var(--spacing-4xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-3xl);
	}

	/* Flex items default to their content width; keep wide tables in the
	   authored body inside the column on small screens. */
	.blog > * {
		min-width: 0;
		max-width: 100%;
	}

	.cluster header,
	.all-guides header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-lg);
	}

	.cluster h2,
	.all-guides h2 {
		font-size: var(--font-size-2xl);
	}

	.cluster-all {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		white-space: nowrap;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>
