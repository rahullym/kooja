---
import { getTaxonomyTermsWithCacheHint } from "emdash";
import CardGrid from "../../../components/CardGrid.astro";
import CtaBand from "../../../components/CtaBand.astro";
import PageHero from "../../../components/PageHero.astro";
import Base from "../../../layouts/Base.astro";
import { getPosts, postCard } from "../../../lib/posts";
import { breadcrumbLd, collectionLd } from "../../../lib/site";

const { slug } = Astro.params;
const termsResult = await getTaxonomyTermsWithCacheHint("category", { includeCounts: false });
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;
if (!term) return Astro.rewrite("/404");

const { entries: posts, cacheHint } = await getPosts(term.slug);
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

const path = `/blog/categories/${term.slug}`;
const title = `${term.label}: Powder Coating Guides`;
const description = term.description ?? undefined;
const crumbs = [
	{ label: "Blog", url: "/blog" },
	{ label: term.label, url: path },
];
const jsonLd = [
	collectionLd({
		name: title,
		description,
		url: `${Astro.url.origin}${path}`,
		items: posts.map((post) => ({ name: post.data.title, url: `${Astro.url.origin}/post/${post.id}` })),
	}),
	breadcrumbLd(Astro.url.origin, crumbs),
];
---

<Base title={`${title} | Koojo`} pageTitle={title} description={description?.slice(0, 160)} jsonLd={jsonLd}>
	<PageHero title={term.label} crumbs={crumbs} eyebrow="Powder coating guides" />

	<div class="container category">
		{term.description && <p class="category-description">{term.description}</p>}
		{posts.length > 0 ? (
			<CardGrid cards={posts.map(postCard)} level={2} />
		) : (
			<p class="empty">Guides in this topic are on the way.</p>
		)}
	</div>

	<CtaBand />
</Base>

<style>
	.category {
		padding-top: var(--spacing-3xl);
		padding-bottom: var(--spacing-4xl);
	}

	.category-description {
		max-width: var(--max-width);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
		margin-bottom: var(--spacing-2xl);
	}

	.empty {
		color: var(--color-muted);
	}
</style>
