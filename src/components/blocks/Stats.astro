---
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";

type StatsBlock = Extract<PageContentBlock, { _type: "site_stats" }>;
type Props = BlockComponentProps<StatsBlock>;

const { value } = Astro.props;
---

<section class="stats" aria-label="Koojo in numbers">
	<ul class="stats-list" style={`--stat-cols: ${Math.min(Math.max(value.items.length, 1), 5)}`}>
		{value.items.map((item) => {
			// Document strips keep their own word order ("10,000+ items coated").
			const valueFirst = (item as { valueFirst?: boolean }).valueFirst;
			const label = item.label ? <span class:list={["label", "stat-label", valueFirst ? "stat-label--after" : "stat-label--before"]}>{item.label}</span> : null;
			const figure = <span class="stat-value">{item.value}</span>;
			return (
				<li class:list={["stat", { "stat--text": !/\d/.test(item.value) }]}>
					{valueFirst ? <>{figure}{label}</> : <>{label}{figure}</>}
				</li>
			);
		})}
	</ul>
</section>

<style>

	.stats {
		border-top: 1px solid var(--color-rule);
	}

	.stats-list {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 0 var(--spacing-lg);
		display: grid;
		grid-template-columns: repeat(var(--stat-cols, 4), minmax(0, 1fr));
	}

	.stat {
		padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-xl) 0;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
	}

	.stat + .stat {
		padding-left: var(--spacing-lg);
		border-left: 1px solid var(--color-border);
	}

	.stats-list {
		list-style: none;
	}

	.stat-value {
		white-space: nowrap;
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3.25rem);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		line-height: 1;
	}

	/* Five items: a little smaller so every figure fits its column. */
	.stats-list[style*="--stat-cols: 5"] .stat-value {
		font-size: clamp(1.75rem, 3vw, 2.6rem);
	}

	/* Figures share one line whether their label comes before or after them. */
	.stat {
		display: grid;
		grid-template-rows: minmax(1.2em, auto) auto minmax(1.2em, auto);
		align-content: start;
		gap: var(--spacing-md);
	}

	.stat-label--before {
		grid-row: 1;
	}

	.stat-value {
		grid-row: 2;
		align-self: end;
	}

	.stat-label--after {
		grid-row: 3;
	}

	.stat--text .stat-value {
		white-space: normal;
		font-size: var(--font-size-lg) !important;
		letter-spacing: normal;
		line-height: 1.3;
		max-width: 16ch;
	}

	@media (max-width: 1000px) {
		.stats-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 700px) {
		.stats-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.stat + .stat:nth-child(odd) {
			padding-left: 0;
			border-left: 0;
		}

		.stat:nth-child(n + 3) {
			border-top: 1px solid var(--color-border);
		}
	}
</style>
