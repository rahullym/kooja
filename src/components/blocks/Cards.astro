---
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import { BUSINESS, getSorted } from "../../lib/site";

type CardsBlock = Extract<PageContentBlock, { _type: "site_cards" }>;
type Props = BlockComponentProps<CardsBlock>;

const LABELS = { services: "Services", industries: "Industries", locations: "Service areas", projects: "Our work" } as const;

const { value } = Astro.props;
const { source, headline, subheadline } = value;

const { entries, cacheHint } = await getSorted(source);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const items = entries.map((entry) => {
	const data = entry.data as {
		title: string;
		nav_label?: string | null;
		summary?: string | null;
		client_industry?: string | null;
		region?: string | null;
		featured_image?: { id: string; src?: string; alt?: string } | null;
	};
	return {
		title: data.nav_label || data.title,
		url: `/${source}/${entry.id}`,
		text: data.summary,
		meta: data.client_industry || data.region,
		image: data.featured_image,
	};
});

const link =
	value.link_label && value.link_url ? { label: value.link_label, url: sanitizeHref(value.link_url) } : null;
const pad = (n: number) => String(n).padStart(2, "0");
---

{items.length > 0 && (
	<section class="section">
		<div class="container">
			<header class="section-header" data-label={LABELS[source]}>
				{headline && <h2 class="section-headline">{headline}</h2>}
				{subheadline && <p class="section-subheadline">{subheadline}</p>}
			</header>

			{source === "projects" ? (
				<ul class="work">
					{items.map((item) => (
						<li>
							<a class="work-link" href={item.url}>
								{item.image && <Image image={item.image} />}
								<span class="work-caption">
									<span class="work-title">{item.title}</span>
									{item.meta && <span class="label">{item.meta}</span>}
								</span>
							</a>
						</li>
					))}
				</ul>
			) : source === "locations" ? (
				<div class="areas">
					<ol class="areas-list">
						{items.map((item, i) => (
							<li>
								<a class="area-link" href={item.url}>
									<span class="label area-n">{pad(i + 1)}</span>
									<span class="area-name">{item.title}</span>
									{item.meta && <span class="label area-region">{item.meta}</span>}
									<span class="area-arrow" aria-hidden="true">&rarr;</span>
								</a>
							</li>
						))}
					</ol>
					<div class="areas-map">
						<iframe
							title={`Map showing ${BUSINESS.name}, ${BUSINESS.street}, ${BUSINESS.city}`}
							src={BUSINESS.mapEmbed}
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"></iframe>
						<address class="areas-plate">
							<span class="label">The shop</span>
							<strong>{BUSINESS.street}</strong>
							<span>{BUSINESS.city}, {BUSINESS.region} {BUSINESS.postalCode}</span>
							<span class="areas-hours">{BUSINESS.hours}</span>
							<a class="areas-directions" href={BUSINESS.mapUrl} target="_blank" rel="noopener noreferrer">
								Get directions <span aria-hidden="true">&rarr;</span>
							</a>
						</address>
					</div>
				</div>
			) : source === "services" ? (
				<div class="rail">
					<div class="rail-controls">
						<button type="button" class="rail-btn" data-rail="-1" aria-label="Previous services" disabled>&larr;</button>
						<button type="button" class="rail-btn" data-rail="1" aria-label="More services">&rarr;</button>
					</div>
					<ol class="rail-track" tabindex="0" aria-label={headline || "Services"}>
						{items.map((item, i) => (
							<li>
								<a class="rail-card" href={item.url} draggable="false">
									{item.image && <Image image={item.image} draggable="false" />}
									<span class="rail-n">{pad(i + 1)}</span>
									<span class="rail-body">
										<span class="rail-title">{item.title}</span>
										{item.text && <span class="rail-text">{item.text}</span>}
										<span class="rail-more">View service <span aria-hidden="true">&rarr;</span></span>
									</span>
								</a>
							</li>
						))}
					</ol>
					<div class="rail-foot">
						<div class="rail-progress" aria-hidden="true"><span></span></div>
						<span class="label">Drag, scroll or use the arrows</span>
					</div>
				</div>
			) : (
				<ol class="index">
					{items.map((item, i) => (
						<li>
							<a class="index-link" href={item.url}>
								<span class="label index-n">{pad(i + 1)}</span>
								<span class="index-title">{item.title}</span>
								{item.text && <span class="index-text">{item.text}</span>}
								<span class="index-arrow" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					))}
				</ol>
			)}

			{link && (
				<p class="more">
					<a href={link.url} class="btn btn-secondary">{link.label}</a>
				</p>
			)}
		</div>
	</section>
)}

<style>
	ul,
	ol {
		list-style: none;
	}

	.more {
		margin-top: var(--spacing-xl);
	}

	/* Services: a rail that scrolls sideways and runs off the right edge. */
	.rail {
		position: relative;
	}

	.rail-controls {
		position: absolute;
		right: 0;
		bottom: calc(100% + var(--spacing-xl));
		display: flex;
		gap: var(--spacing-sm);
	}

	.rail-btn {
		width: 3rem;
		height: 3rem;
		font: inherit;
		font-size: var(--font-size-lg);
		color: var(--color-text);
		background: transparent;
		border: 1px solid var(--color-rule);
		border-radius: 50%;
		cursor: pointer;
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.rail-btn:hover:not(:disabled) {
		background: var(--color-text);
		color: var(--color-bg);
	}

	.rail-btn:disabled {
		opacity: 0.3;
		cursor: default;
	}

	.rail-track {
		--bleed: max(var(--spacing-lg), calc((100vw - var(--wide-width)) / 2 + var(--spacing-lg)));
		display: flex;
		gap: var(--spacing-md);
		/* Bleed to the window's right edge, keeping the first card on the grid. */
		margin-right: calc(-1 * var(--bleed));
		padding-right: var(--bleed);
		overflow-x: auto;
		scroll-snap-type: x proximity;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		cursor: grab;
	}

	.rail-track::-webkit-scrollbar {
		display: none;
	}

	.rail-track.dragging {
		cursor: grabbing;
		scroll-snap-type: none;
		user-select: none;
	}

	.rail-track li {
		flex: 0 0 min(380px, 80vw);
		scroll-snap-align: start;
	}

	/* Each card is a tall photo with the service name set over it. */
	.rail-card {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		aspect-ratio: 4 / 5;
		border-radius: var(--radius-lg);
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.rail-card :global(img) {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms ease;
	}

	.rail-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(to top, rgb(22 20 18 / 0.94) 0%, rgb(22 20 18 / 0.7) 38%, rgb(22 20 18 / 0) 68%);
		transition: background var(--transition-slow);
	}

	.rail-card::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 5px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--transition-slow);
	}

	.rail-n {
		position: absolute;
		top: 0;
		left: 0;
		padding: 0.55rem 0.9rem;
		border-bottom-right-radius: var(--radius);
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 500;
		background: var(--color-paper);
		color: var(--color-ink);
	}

	.rail-body {
		display: flex;
		flex-direction: column;
		padding: var(--spacing-lg);
	}

	.rail-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		font-weight: 800;
		letter-spacing: var(--tracking-snug);
		line-height: 1.05;
		text-wrap: balance;
	}

	/* The summary and link slide open on hover or keyboard focus. */
	.rail-text,
	.rail-more {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height var(--transition-slow),
			opacity var(--transition-slow),
			margin var(--transition-slow);
	}

	.rail-text {
		font-size: var(--font-size-sm);
		line-height: 1.5;
		opacity: 0;
	}

	.rail-more {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-accent);
	}

	.rail-card:is(:hover, :focus-visible) :global(img) {
		transform: scale(1.05);
	}

	.rail-card:is(:hover, :focus-visible)::before {
		background: linear-gradient(to top, rgb(22 20 18 / 0.96) 0%, rgb(22 20 18 / 0.86) 55%, rgb(22 20 18 / 0.25) 100%);
	}

	.rail-card:is(:hover, :focus-visible)::after {
		transform: scaleX(1);
	}

	.rail-card:is(:hover, :focus-visible) .rail-text {
		max-height: 8em;
		opacity: 0.85;
		margin-top: var(--spacing-sm);
	}

	.rail-card:is(:hover, :focus-visible) .rail-more {
		max-height: 2em;
		opacity: 1;
		margin-top: var(--spacing-md);
	}

	/* Touch screens have no hover: keep the summary open. */
	@media (hover: none) {
		.rail-text {
			max-height: 8em;
			opacity: 0.85;
			margin-top: var(--spacing-sm);
		}

		.rail-more {
			max-height: 2em;
			opacity: 1;
			margin-top: var(--spacing-md);
		}
	}

	.rail-foot {
		margin-top: var(--spacing-lg);
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
	}

	.rail-progress {
		flex: 1;
		height: 4px;
		border-radius: var(--radius-full);
		overflow: hidden;
		background: var(--color-border);
	}

	.rail-progress span {
		display: block;
		height: 100%;
		width: 20%;
		background: var(--color-brand);
		transform-origin: left;
	}

	@media (max-width: 800px) {
		.rail-controls {
			position: static;
			margin-bottom: var(--spacing-md);
		}
	}

	/* Industries: a numbered, ruled index. */
	.index {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.index-link {
		position: relative;
		height: 100%;
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
		gap: 0.25rem var(--spacing-sm);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px solid var(--color-border);
		transition: border-color var(--transition-fast);
	}

	.index-n {
		padding-top: 0.45em;
	}

	.index-title {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		font-weight: 700;
		letter-spacing: var(--tracking-snug);
	}

	.index-text {
		grid-column: 2;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		max-width: 46ch;
	}

	.index-arrow {
		grid-column: 3;
		grid-row: 1;
		color: var(--color-brand);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.index-link:hover {
		border-bottom-color: var(--color-brand);
	}

	.index-link:hover .index-title {
		color: var(--color-brand);
	}

	.index-link:hover .index-arrow {
		opacity: 1;
		transform: none;
	}

	/* Projects: photo mosaic, first job large. */
	.work {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-lg) var(--spacing-md);
	}

	.work li:first-child {
		grid-column: span 2;
		grid-row: span 2;
	}

	.work-link {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.work :global(img) {
		width: 100%;
		flex: 1;
		min-height: 0;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		display: block;
		border-radius: var(--radius-lg);
		filter: saturate(0.9);
		transition: filter var(--transition-slow);
	}

	.work-link:hover :global(img) {
		filter: none;
	}

	.work-caption {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding-top: var(--spacing-sm);
		border-top: 2px solid transparent;
	}

	.work-title {
		font-weight: 600;
	}

	.work-link:hover .work-title {
		color: var(--color-brand);
	}

	/* Locations: the cities as a ruled list beside a map of the shop. */
	.areas {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: var(--spacing-2xl);
		align-items: stretch;
	}

	.areas-list {
		border-top: 1px solid var(--color-rule);
	}

	.area-link {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto 1.5rem;
		align-items: baseline;
		gap: var(--spacing-md);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px solid var(--color-border);
		transition:
			padding var(--transition-base),
			border-color var(--transition-base);
	}

	.area-name {
		font-family: var(--font-heading);
		font-size: clamp(1.6rem, 3vw, 2.4rem);
		font-weight: 800;
		letter-spacing: var(--tracking-tight);
		line-height: 1;
	}

	/* The head office row carries the accent. */
	.areas-list li:first-child .area-name {
		color: var(--color-brand);
	}

	.area-arrow {
		color: var(--color-brand);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.area-link:hover {
		padding-left: var(--spacing-sm);
		border-bottom-color: var(--color-brand);
	}

	.area-link:hover .area-name {
		color: var(--color-brand);
	}

	.area-link:hover .area-arrow {
		opacity: 1;
		transform: none;
	}

	.areas-map {
		position: relative;
		min-height: 420px;
		border: 1px solid var(--color-rule);
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.areas-map iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		filter: grayscale(1) contrast(1.05);
	}

	.areas-plate {
		position: absolute;
		left: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: var(--spacing-lg);
		border-top-right-radius: var(--radius-lg);
		font-style: normal;
		background: var(--color-ink);
		color: var(--color-paper);
	}

	.areas-plate .label {
		color: var(--color-accent);
		margin-bottom: var(--spacing-xs);
	}

	.areas-plate strong {
		font-family: var(--font-heading);
		font-size: var(--font-size-xl);
		letter-spacing: var(--tracking-snug);
	}

	.areas-hours {
		font-size: var(--font-size-sm);
		opacity: 0.7;
	}

	.areas-directions {
		margin-top: var(--spacing-sm);
		font-weight: 600;
		color: var(--color-accent);
	}

	.areas-directions:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 900px) {
		.index {
			grid-template-columns: minmax(0, 1fr);
		}

		.work {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.areas {
			grid-template-columns: minmax(0, 1fr);
		}

		.areas-map {
			min-height: 380px;
		}

		.area-link {
			grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
		}

		.area-region {
			display: none;
		}
	}
</style>

<script>
	// Services rail: arrow buttons, click-and-drag, and a progress line.
	document.querySelectorAll<HTMLElement>(".rail").forEach((rail) => {
		const track = rail.querySelector<HTMLElement>(".rail-track");
		const bar = rail.querySelector<HTMLElement>(".rail-progress span");
		const buttons = rail.querySelectorAll<HTMLButtonElement>(".rail-btn");
		if (!track) return;

		const update = () => {
			const max = track.scrollWidth - track.clientWidth;
			buttons.forEach((button) => {
				button.disabled = button.dataset.rail === "-1" ? track.scrollLeft <= 2 : track.scrollLeft >= max - 2;
			});
			if (bar) {
				const shown = Math.min(1, track.clientWidth / track.scrollWidth);
				const moved = max > 0 ? track.scrollLeft / max : 0;
				bar.style.width = `${shown * 100}%`;
				bar.style.marginLeft = `${moved * (1 - shown) * 100}%`;
			}
		};

		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				const card = track.querySelector("li");
				const step = (card?.getBoundingClientRect().width ?? 380) + 16;
				track.scrollBy({ left: Number(button.dataset.rail) * step, behavior: "smooth" });
			});
		});

		// Mouse drag. A drag of more than a few pixels must not follow the link.
		let startX = 0;
		let startScroll = 0;
		let dragging = false;
		let moved = false;

		track.addEventListener("pointerdown", (event) => {
			if (event.pointerType !== "mouse" || event.button !== 0) return;
			dragging = true;
			moved = false;
			startX = event.clientX;
			startScroll = track.scrollLeft;
		});

		window.addEventListener("pointermove", (event) => {
			if (!dragging) return;
			const delta = event.clientX - startX;
			if (Math.abs(delta) > 5) {
				moved = true;
				track.classList.add("dragging");
			}
			if (moved) track.scrollLeft = startScroll - delta;
		});

		window.addEventListener("pointerup", () => {
			dragging = false;
			track.classList.remove("dragging");
		});

		track.addEventListener(
			"click",
			(event) => {
				if (moved) {
					event.preventDefault();
					moved = false;
				}
			},
			true,
		);

		track.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		update();
	});
</script>
