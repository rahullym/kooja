---
import { Image } from "emdash/ui";

export interface Card {
	title: string;
	url: string;
	text?: string | null;
	image?: { id: string; src?: string; alt?: string } | null;
	meta?: string | null;
	tags?: string[];
}

interface Props {
	cards: Card[];
	columns?: 2 | 3 | 4;
	/** Heading level for card titles, so cards nest correctly under the section heading. */
	level?: 2 | 3;
}

const { cards, columns = 3, level = 3 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<ul class={`card-grid cols-${columns}`}>
	{cards.map((card) => (
		<li class="card" data-tags={card.tags?.join(" ")}>
			{card.image && (
				<div class="card-media">
					<Image image={card.image} />
				</div>
			)}
			<div class="card-body">
				{card.meta && <p class="card-meta">{card.meta}</p>}
				<Heading class="card-title">
					<a class="card-link" href={card.url}>{card.title}</a>
				</Heading>
				{card.text && <p class="card-text">{card.text}</p>}
			</div>
		</li>
	))}
</ul>

<style>
	.card-grid {
		list-style: none;
		display: grid;
		gap: var(--spacing-2xl) var(--spacing-xl);
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.cols-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.cols-4 {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		border-top: 1px solid var(--color-rule);
	}

	.card[hidden] {
		display: none;
	}

	.card-media {
		order: 2;
		aspect-ratio: 3 / 2;
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: var(--color-surface);
	}

	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-body {
		padding: var(--spacing-md) 0 var(--spacing-lg);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.card-meta {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.card-title {
		font-size: var(--font-size-xl);
		line-height: 1.15;
		text-wrap: balance;
	}

	.card:hover .card-link {
		color: var(--color-brand);
	}

	/* Stretch the title link over the whole card. */
	.card-link::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.card-text {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	@media (max-width: 1024px) {
		.card-grid,
		.cols-4 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 600px) {
		.card-grid,
		.cols-2,
		.cols-4 {
			grid-template-columns: 1fr;
		}
	}
</style>
