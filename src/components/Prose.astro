---
import { PortableText } from "emdash/ui";
import Buttons from "./doc/Buttons.astro";
import Cards from "./doc/Cards.astro";
import Cta from "./doc/Cta.astro";
import Faq from "./doc/Faq.astro";
import Form from "./doc/Form.astro";
import Hidden from "./doc/Hidden.astro";
import Map from "./doc/Map.astro";
import Strip from "./doc/Strip.astro";

// Custom blocks used by pages built from the client's content documents.
const components = {
	type: { koojoStrip: Strip, koojoCards: Cards, koojoFaq: Faq, koojoCta: Cta, koojoByline: Hidden, koojoIntroInBody: Hidden, koojoGallery: Hidden, koojoMap: Map, koojoForm: Form, koojoButtons: Buttons },
};

interface Props {
	value?: unknown[] | null;
}

const { value } = Astro.props;
---

{value && value.length > 0 && (
	<div class="prose">
		<PortableText value={value as never} components={components} />
	</div>
)}

<style>
	.prose {
		max-width: var(--max-width);
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.prose :global(h2) {
		margin-top: var(--spacing-2xl);
		margin-bottom: var(--spacing-md);
	}

	.prose :global(h3),
	.prose :global(h4) {
		margin-top: var(--spacing-xl);
		margin-bottom: var(--spacing-sm);
	}

	.prose :global(:is(h2, h3, h4):first-child) {
		margin-top: 0;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(blockquote) {
		margin-bottom: var(--spacing-md);
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.4em;
	}

	.prose :global(li) {
		margin-bottom: var(--spacing-sm);
	}

	.prose :global(li::marker) {
		color: var(--color-brand);
	}

	.prose :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.prose :global(img) {
		border-radius: var(--radius);
		margin: var(--spacing-lg) 0;
	}
</style>
