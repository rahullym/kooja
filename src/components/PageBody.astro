---
/**
 * Body shared by standalone pages (About, Capabilities, Certification, ...):
 * optional image, rich text, optional block sections, FAQ.
 */
import type { getEmDashEntry } from "emdash";
import { Image } from "emdash/ui";
import { docParts, type Faq } from "../lib/site";
import InnerSections from "./doc/InnerSections.astro";
import FaqSection from "./FaqSection.astro";
import MarketingBlocks from "./MarketingBlocks.astro";
import Prose from "./Prose.astro";

interface Props {
	page: NonNullable<Awaited<ReturnType<typeof getEmDashEntry<"pages">>>["entry"]>;
	/** Photo shown in the hero, so document sections do not repeat it. */
	heroImage?: unknown;
}

const { page, heroImage } = Astro.props;
const { data } = page;
const faqs = (data.faqs ?? []) as Faq[];
const doc = docParts(data.body);
// Extra markup a page passes in (e.g. a form) — only shown when there is some.
const after = doc.fromDoc && Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

{doc.fromDoc ? (
	<>
		<InnerSections value={data.body} heroImage={heroImage} />
		{after && <div class="page-body page-body--after" set:html={after} />}
	</>
) : (
<div class="page-body">
	<slot name="before" />
	<div class:list={["page-columns", { "has-image": !!data.featured_image }]}>
		<div {...page.edit.body}>
			<Prose value={data.body} />
		</div>
		{data.featured_image && (
			<figure class="page-image" {...page.edit.featured_image}>
				<Image image={data.featured_image} />
			</figure>
		)}
	</div>
	<slot />
	{!doc.hasFaq && <FaqSection faqs={faqs} />}
</div>
)}

{!doc.fromDoc && data.content && data.content.length > 0 && (
	<div {...page.edit.content}>
		<MarketingBlocks value={data.content} />
	</div>
)}

<style>
	.page-body--after {
		padding-top: 0;
	}



	.page-body {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3xl) var(--spacing-lg) var(--spacing-4xl);
	}

	.page-columns.has-image {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
		gap: var(--spacing-3xl);
		align-items: start;
	}

	.page-image {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}

	@media (max-width: 900px) {
		.page-columns.has-image {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
