---
import { Image } from "emdash/ui";
import type { Crumb } from "../lib/site";

interface Props {
	title: string;
	intro?: string | null;
	crumbs?: Crumb[];
	eyebrow?: string | null;
	titleAttrs?: Record<string, unknown>;
	cta?: boolean;
	/** Byline from the content document, shown under the H1. */
	byline?: string | null;
	/** Shop photo shown beside the hero text. */
	image?: unknown;
}

const { title, intro, crumbs = [], eyebrow, titleAttrs = {}, cta = false, byline, image } = Astro.props;
const photo = image as { alt?: string } | null | undefined;
---

<header class:list={["page-hero", { "page-hero--photo": !!image }]}>
	<div class="page-hero-inner">
		<div class="page-hero-text">
		{crumbs.length > 0 && (
			<nav class="crumbs label" aria-label="Breadcrumb">
				<a href="/">Home</a>
				{crumbs.map((crumb) => (
					<>
						<span aria-hidden="true">/</span>
						<a href={crumb.url}>{crumb.label}</a>
					</>
				))}
			</nav>
		)}
		{eyebrow && <p class="label eyebrow">{eyebrow}</p>}
		<h1 {...titleAttrs}>{title}</h1>
		{byline && <p class="label page-hero-byline">{byline}</p>}
		{intro && <p class="page-hero-intro">{intro}</p>}
		{cta && (
			<div class="page-hero-actions">
				<a href="/get-a-quote" class="btn btn-primary">Get a Quote</a>
				<a href="tel:+19058767060" class="btn btn-secondary">Call (905) 876-7060</a>
			</div>
		)}
		<slot />
		</div>
		{image && (
			<figure class="page-hero-photo">
				<Image image={image as never} priority />
				{photo?.alt && <figcaption class="label">{photo.alt}</figcaption>}
			</figure>
		)}
	</div>
</header>

<style>
	.page-hero--photo .page-hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: var(--spacing-3xl);
		align-items: end;
	}

	.page-hero-photo {
		margin: 0;
	}

	.page-hero-photo :global(img) {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.page-hero-photo figcaption {
		margin-top: var(--spacing-sm);
	}

	@media (max-width: 900px) {
		.page-hero--photo .page-hero-inner {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-xl);
		}
	}

	.page-hero-byline {
		margin-top: var(--spacing-md);
		color: var(--color-muted);
	}

	.page-hero {
		border-bottom: 1px solid var(--color-rule);
	}

	.page-hero-inner {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-2xl);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-2xl);
	}

	.crumbs a:hover {
		color: var(--color-brand);
	}

	.eyebrow {
		color: var(--color-brand);
		margin-bottom: var(--spacing-md);
	}

	h1 {
		max-width: 18ch;
		text-wrap: balance;
	}

	.page-hero-intro {
		max-width: 56ch;
		margin-top: var(--spacing-lg);
		font-size: var(--font-size-xl);
		line-height: 1.45;
		color: var(--color-muted);
	}

	.page-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
	}
</style>
