---
/** Card list written in a content document (title, text and optional link). */
import CardGrid, { type Card } from "../CardGrid.astro";

const { node } = Astro.props as { node: { items?: { title: string; text?: string | null; url?: string | null }[] } };
const cards: Card[] = (node.items ?? []).map((item) => ({ title: item.title, text: item.text, url: item.url || "" }));
---

<div class="doc-cards">
	<CardGrid cards={cards} columns={2} />
</div>

<style>
	.doc-cards {
		margin: var(--spacing-xl) 0;
		font-size: var(--font-size-base);
	}

	/* Cards sit inside article text: drop the list indent and link styling. */
	.doc-cards.doc-cards :global(ul) {
		padding-left: 0;
		margin: 0;
	}

	.doc-cards.doc-cards :global(.card-grid) {
		gap: var(--spacing-lg) var(--spacing-xl);
	}

	.doc-cards.doc-cards :global(li) {
		margin: 0;
	}

	.doc-cards.doc-cards :global(li::marker) {
		content: none;
	}

	.doc-cards.doc-cards :global(a) {
		color: var(--color-text);
		text-decoration: none;
	}

	.doc-cards.doc-cards :global(a:hover) {
		color: var(--color-brand);
	}

	.doc-cards.doc-cards :global(.card-title) {
		font-size: var(--font-size-lg);
		text-transform: none;
	}
</style>
