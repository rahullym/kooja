---
/** A document section in the original site style: mono label, headline, copy. */
import Prose from "../Prose.astro";

interface Props {
	label: string;
	headline?: string | null;
	blocks: unknown[];
}

const { label, headline, blocks } = Astro.props;
---

<section class="section">
	<div class="container">
		<header class="section-header" data-label={label}>
			{headline && <h2 class="section-headline">{headline}</h2>}
		</header>
		<div class="old-body">
			<Prose value={blocks} />
		</div>
	</div>
</section>

<style>
	.old-body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: var(--spacing-2xl);
	}

	.old-body > :global(*) {
		grid-column: 2;
	}

	@media (max-width: 800px) {
		.old-body {
			grid-template-columns: minmax(0, 1fr);
		}

		.old-body > :global(*) {
			grid-column: 1;
		}
	}
</style>
