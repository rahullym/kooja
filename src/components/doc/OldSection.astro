---
/**
 * A document section in the original site style: mono label on the left,
 * headline and copy together in the right-hand column.
 */
import Prose from "../Prose.astro";

interface Props {
	label: string;
	headline?: string | null;
	blocks: unknown[];
}

const { label, headline, blocks } = Astro.props;
---

<section class="section">
	<div class="container">
		<header class="section-header old-header" data-label={label}>
			{headline && <h2 class="section-headline">{headline}</h2>}
			<div class="old-body">
				<Prose value={blocks} />
			</div>
		</header>
	</div>
</section>

<style>
	.old-header {
		margin-bottom: 0;
	}

	.old-body {
		grid-column: 2;
	}

	.old-body :global(.prose) {
		max-width: 62ch;
	}

	.old-body :global(.prose > :last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 800px) {
		.old-body {
			grid-column: 1;
		}
	}
</style>
