---
import { BUSINESS } from "../lib/site";

interface Props {
	defaultService?: string;
}

const { defaultService = "" } = Astro.props;

const services = [
	"Industrial Powder Coating",
	"Surface Preparation",
	"Sandblasting",
	"Custom Colours & Finishes",
	"Restoration & Recoating",
	"Automotive Powder Coating",
	"Wheels & Rims",
	"Architectural Powder Coating",
	"Commercial & Bulk Orders",
	"Specialty & Custom Projects",
];
---

<div class="quote-form-container" id="quote-form-section">
	<div class="form-header">
		<span class="label form-label">Direct RFQ · 1 Business Day Response</span>
		<h2 class="form-title">Request a Quote Online</h2>
		<p class="form-desc">
			Fill out the specifications below or send CAD drawings directly to <a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>.
		</p>
	</div>

	<div id="quote-form-success" class="quote-status-card success-card" style="display: none;" role="alert">
		<div class="status-icon">✓</div>
		<div class="status-body">
			<h3>Quote Request Submitted</h3>
			<p id="quote-success-message">
				Thank you! Your quote request has been received. Our team will review your specifications and respond within 1 business day.
			</p>
			<p class="reference-tag">Reference: <strong id="quote-ref-code"></strong></p>
			<div class="status-actions">
				<a href={`tel:${BUSINESS.phoneHref}`} class="btn btn-secondary">Call (905) 876-7060</a>
				<button type="button" class="btn btn-secondary" id="quote-reset-btn">Submit Another Request</button>
			</div>
		</div>
	</div>

	<div id="quote-form-error" class="quote-status-card error-card" style="display: none;" role="alert">
		<div class="status-icon">!</div>
		<div class="status-body">
			<h3>Submission Error</h3>
			<p id="quote-error-message">Please correct the highlighted fields and try again.</p>
		</div>
	</div>

	<form id="quote-form" class="quote-form" novalidate>
		<div class="form-grid">
			<div class="form-group">
				<label for="qf-name" class="label">Full Name <span class="req">*</span></label>
				<input type="text" id="qf-name" name="name" required autocomplete="name" placeholder="e.g. John Miller" />
				<span class="field-error" id="err-name"></span>
			</div>

			<div class="form-group">
				<label for="qf-email" class="label">Work Email <span class="req">*</span></label>
				<input type="email" id="qf-email" name="email" required autocomplete="email" placeholder="e.g. jmiller@company.com" />
				<span class="field-error" id="err-email"></span>
			</div>

			<div class="form-group">
				<label for="qf-phone" class="label">Phone Number <span class="req">*</span></label>
				<input type="tel" id="qf-phone" name="phone" required autocomplete="tel" placeholder="e.g. (905) 555-0123" />
				<span class="field-error" id="err-phone"></span>
			</div>

			<div class="form-group">
				<label for="qf-company" class="label">Company / Shop Name</label>
				<input type="text" id="qf-company" name="company" autocomplete="organization" placeholder="e.g. Miller Fabrication Ltd." />
			</div>

			<div class="form-group">
				<label for="qf-service" class="label">Service Required</label>
				<select id="qf-service" name="service">
					<option value="">Select a service...</option>
					{
						services.map((svc) => (
							<option value={svc} selected={svc.toLowerCase() === defaultService.toLowerCase()}>
								{svc}
							</option>
						))
					}
				</select>
			</div>

			<div class="form-group">
				<label for="qf-quantity" class="label">Quantity / Batch Size</label>
				<input type="text" id="qf-quantity" name="quantity" placeholder="e.g. 1 proto, 50 production units" />
			</div>

			<div class="form-group">
				<label for="qf-dimensions" class="label">Part Dimensions &amp; Weight</label>
				<input type="text" id="qf-dimensions" name="dimensions" placeholder="e.g. 8 ft x 4 ft x 3 ft, 450 lbs (Oven: 23 ft, 6,000 lb)" />
			</div>

			<div class="form-group">
				<label for="qf-finish" class="label">Colour / Finish / RAL Code</label>
				<input type="text" id="qf-finish" name="finish" placeholder="e.g. RAL 7016 Anthracite Grey, Satin" />
			</div>

			<div class="form-group">
				<label for="qf-timeline" class="label">Needed By / Turnaround</label>
				<input type="text" id="qf-timeline" name="timeline" placeholder="e.g. Standard (3-5 days), Rush (48h)" />
			</div>

			<div class="form-group form-group--full">
				<label for="qf-message" class="label">Project Details &amp; Specifications <span class="req">*</span></label>
				<textarea
					id="qf-message"
					name="message"
					rows="4"
					required
					placeholder="Describe metal type, surface condition (bare, painted, rusted), masking requirements, or special environment exposure..."
				></textarea>
				<span class="field-error" id="err-message"></span>
			</div>
		</div>

		<div class="form-notice">
			<span class="notice-icon">ℹ</span>
			<p>
				Have blueprints, CAD files or photos? Email files directly to
				<a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a>
				referencing your project name.
			</p>
		</div>

		<div class="form-actions">
			<button type="submit" class="btn btn-primary btn-lg" id="qf-submit-btn">
				<span class="btn-text">Submit Quote Request</span>
				<span class="btn-spinner" style="display: none;" aria-hidden="true">...</span>
			</button>
			<span class="privacy-note">We never share your contact details. Responses sent within 1 business day.</span>
		</div>
	</form>
</div>

<script>
	const form = document.getElementById("quote-form") as HTMLFormElement | null;
	const successCard = document.getElementById("quote-form-success");
	const errorCard = document.getElementById("quote-form-error");
	const successMsg = document.getElementById("quote-success-message");
	const refCode = document.getElementById("quote-ref-code");
	const errorMsg = document.getElementById("quote-error-message");
	const submitBtn = document.getElementById("qf-submit-btn") as HTMLButtonElement | null;
	const resetBtn = document.getElementById("quote-reset-btn");

	function clearErrors() {
		document.querySelectorAll(".field-error").forEach((el) => {
			el.textContent = "";
		});
		document.querySelectorAll(".form-group input, .form-group textarea").forEach((el) => {
			el.classList.remove("has-error");
		});
		if (errorCard) errorCard.style.display = "none";
	}

	function setError(fieldId: string, errId: string, message: string) {
		const field = document.getElementById(fieldId);
		const errEl = document.getElementById(errId);
		if (field) field.classList.add("has-error");
		if (errEl) errEl.textContent = message;
	}

	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			clearErrors();

			const nameInput = document.getElementById("qf-name") as HTMLInputElement;
			const emailInput = document.getElementById("qf-email") as HTMLInputElement;
			const phoneInput = document.getElementById("qf-phone") as HTMLInputElement;
			const companyInput = document.getElementById("qf-company") as HTMLInputElement;
			const serviceInput = document.getElementById("qf-service") as HTMLSelectElement;
			const dimensionsInput = document.getElementById("qf-dimensions") as HTMLInputElement;
			const quantityInput = document.getElementById("qf-quantity") as HTMLInputElement;
			const finishInput = document.getElementById("qf-finish") as HTMLInputElement;
			const timelineInput = document.getElementById("qf-timeline") as HTMLInputElement;
			const messageInput = document.getElementById("qf-message") as HTMLTextAreaElement;

			let hasError = false;

			if (!nameInput.value.trim()) {
				setError("qf-name", "err-name", "Please enter your name.");
				hasError = true;
			}

			const emailVal = emailInput.value.trim();
			const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
			if (!emailVal) {
				setError("qf-email", "err-email", "Please enter your email address.");
				hasError = true;
			} else if (!emailRegex.test(emailVal)) {
				setError("qf-email", "err-email", "Please enter a valid email address (e.g. name@company.com).");
				hasError = true;
			}

			const phoneVal = phoneInput.value.trim();
			const phoneDigits = phoneVal.replace(/\D/g, "");
			if (!phoneVal) {
				setError("qf-phone", "err-phone", "Please enter your phone number.");
				hasError = true;
			} else if (phoneDigits.length < 10) {
				setError("qf-phone", "err-phone", "Please enter a valid 10-digit phone number.");
				hasError = true;
			}

			if (!messageInput.value.trim()) {
				setError("qf-message", "err-message", "Please provide project details or description.");
				hasError = true;
			}

			if (hasError) {
				if (errorCard && errorMsg) {
					errorMsg.textContent = "Please fill in the required fields highlighted above.";
					errorCard.style.display = "flex";
					errorCard.scrollIntoView({ behavior: "smooth", block: "center" });
				}
				return;
			}

			// Prevent duplicate submission
			if (submitBtn) {
				submitBtn.disabled = true;
				const btnText = submitBtn.querySelector(".btn-text");
				const btnSpinner = submitBtn.querySelector(".btn-spinner");
				if (btnText) (btnText as HTMLElement).textContent = "Submitting Quote...";
				if (btnSpinner) (btnSpinner as HTMLElement).style.display = "inline";
			}

			const payload = {
				name: nameInput.value.trim(),
				email: emailVal,
				phone: phoneVal,
				company: companyInput.value.trim(),
				service: serviceInput.value,
				dimensions: dimensionsInput.value.trim(),
				quantity: quantityInput.value.trim(),
				finish: finishInput.value.trim(),
				timeline: timelineInput.value.trim(),
				message: messageInput.value.trim(),
			};

			try {
				const res = await fetch("/api/quote", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});

				const result = await res.json();

				if (res.ok && result.success) {
					form.style.display = "none";
					if (successCard) {
						if (refCode) refCode.textContent = result.reference || "KQ-" + Date.now().toString(36).toUpperCase();
						if (successMsg && result.message) successMsg.textContent = result.message;
						successCard.style.display = "flex";
						successCard.scrollIntoView({ behavior: "smooth", block: "center" });
					}
				} else {
					throw new Error(result.error || "Submission failed. Please email us directly.");
				}
			} catch (err: any) {
				if (errorCard && errorMsg) {
					errorMsg.textContent = err.message || "An error occurred. Please call or email sales@koojopowdercoating.com.";
					errorCard.style.display = "flex";
				}
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					const btnText = submitBtn.querySelector(".btn-text");
					const btnSpinner = submitBtn.querySelector(".btn-spinner");
					if (btnText) (btnText as HTMLElement).textContent = "Submit Quote Request";
					if (btnSpinner) (btnSpinner as HTMLElement).style.display = "none";
				}
			}
		});
	}

	if (resetBtn && form && successCard) {
		resetBtn.addEventListener("click", () => {
			form.reset();
			form.style.display = "block";
			successCard.style.display = "none";
			clearErrors();
		});
	}
</script>

<style>
	.quote-form-container {
		margin: var(--spacing-3xl) 0;
		padding: var(--spacing-3xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		max-width: 100%;
		box-sizing: border-box;
	}

	.form-header {
		margin-bottom: var(--spacing-2xl);
	}

	.form-label {
		display: inline-block;
		margin-bottom: var(--spacing-xs);
		color: var(--color-brand);
	}

	.form-title {
		font-size: var(--font-size-3xl);
		margin-bottom: var(--spacing-xs);
	}

	.form-desc {
		color: var(--color-muted);
		font-size: var(--font-size-base);
	}

	.form-desc a {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.quote-form {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xl);
	}

	.form-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--spacing-lg);
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}

	.form-group--full {
		grid-column: 1 / -1;
	}

	label {
		font-size: var(--font-size-xs);
		font-family: var(--font-mono);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text);
		font-weight: 600;
	}

	.req {
		color: var(--color-brand);
	}

	input,
	select,
	textarea {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		padding: 0.75rem 1rem;
		background: var(--color-bg);
		color: var(--color-text);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		transition: border-color var(--transition-fast), outline var(--transition-fast);
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
	}

	input:focus,
	select:focus,
	textarea:focus {
		outline: 2px solid var(--color-brand);
		outline-offset: -1px;
		border-color: var(--color-brand);
	}

	input.has-error,
	textarea.has-error {
		border-color: var(--color-danger);
		outline-color: var(--color-danger);
	}

	.field-error {
		font-size: var(--font-size-xs);
		color: var(--color-danger);
		min-height: 1.2em;
	}

	.form-notice {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-sm);
		padding: var(--spacing-md) var(--spacing-lg);
		background: color-mix(in srgb, var(--color-brand) 8%, transparent);
		border-left: 3px solid var(--color-brand);
		border-radius: var(--radius-sm);
		font-size: var(--font-size-sm);
		color: var(--color-text);
	}

	.notice-icon {
		font-weight: bold;
		color: var(--color-brand);
	}

	.form-notice a {
		color: var(--color-brand);
		font-weight: 600;
		text-decoration: underline;
	}

	.form-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-md);
	}

	.privacy-note {
		font-family: var(--font-mono);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.quote-status-card {
		display: flex;
		gap: var(--spacing-lg);
		padding: var(--spacing-2xl);
		border-radius: var(--radius);
		margin-bottom: var(--spacing-2xl);
	}

	.success-card {
		background: color-mix(in srgb, var(--color-success) 12%, transparent);
		border: 1px solid var(--color-success);
	}

	.success-card .status-icon {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--color-success);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: bold;
		font-size: 1.25rem;
		flex-shrink: 0;
	}

	.error-card {
		background: color-mix(in srgb, var(--color-danger) 12%, transparent);
		border: 1px solid var(--color-danger);
	}

	.error-card .status-icon {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--color-danger);
		color: white;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: bold;
		font-size: 1.25rem;
		flex-shrink: 0;
	}

	.status-body h3 {
		margin-bottom: var(--spacing-xs);
		font-size: var(--font-size-xl);
	}

	.reference-tag {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		margin-top: var(--spacing-xs);
		color: var(--color-text);
	}

	.status-actions {
		display: flex;
		gap: var(--spacing-md);
		margin-top: var(--spacing-lg);
	}

	@media (max-width: 768px) {
		.quote-form-container {
			padding: var(--spacing-xl) var(--spacing-lg);
		}

		.form-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-md);
		}

		.form-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.form-actions .btn {
			width: 100%;
		}
	}

	@media (max-width: 480px) {
		.quote-form-container {
			padding: var(--spacing-lg) var(--spacing-md);
			margin: var(--spacing-2xl) 0;
			border-radius: var(--radius);
		}

		.form-title {
			font-size: var(--font-size-2xl);
		}

		.quote-status-card {
			flex-direction: column;
			padding: var(--spacing-lg);
		}

		.status-actions {
			flex-direction: column;
			width: 100%;
		}

		.status-actions .btn {
			width: 100%;
			text-align: center;
		}

		.privacy-note {
			text-align: center;
		}
	}
</style>
